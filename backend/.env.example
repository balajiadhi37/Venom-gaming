# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/venom-gaming
# Comma separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Shared secret required on the admin read/update endpoints (x-admin-key header).
ADMIN_KEY=change-me

# --- WhatsApp Cloud API (optional) ---
# Leave blank to disable booking acknowledgements; the API still works without them.
# Meta App Dashboard > WhatsApp > API Setup. This is the numeric phone number ID,
# not the phone number itself and not the WhatsApp Business Account ID.
WHATSAPP_PHONE_NUMBER_ID=
# System User token with whatsapp_business_messaging. Secret — never commit a real one.
# The token shown on the dashboard expires in ~24 hours and is for testing only.
WHATSAPP_ACCESS_TOKEN=
# Approved template. The language code must match the template exactly ("en" != "en_US").
WHATSAPP_TEMPLATE_NAME=booking_ack
WHATSAPP_TEMPLATE_LANGUAGE=en
# Graph API version; Meta expires versions roughly two years after release.
WHATSAPP_API_VERSION=v23.0
# Override only to point at the local stub during development.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Prefixed onto the stored 10-digit numbers. 91 = India.
WHATSAPP_COUNTRY_CODE=91

# --- Which transport sends admin email: "gmail" (default) or "smtp" ---
MAIL_PROVIDER=gmail

# --- Gmail API (the default provider) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Enable the Gmail API on the project first.
# Add GOOGLE_REDIRECT_URI below to the client's "Authorised redirect URIs".
GOOGLE_CLIENT_ID=  
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/mail/gmail/callback
# Encrypts the stored Google refresh token. Falls back to ADMIN_KEY when blank.
# Changing either value invalidates the stored token — just reconnect Gmail.
TOKEN_ENCRYPTION_KEY=

# --- SMTP, used only when MAIL_PROVIDER=smtp (optional) ---
# Leave blank to disable; the Email button then reports "not configured".
# Gmail example: smtp.gmail.com / 587 / your address / a 16-char App Password
# (a normal Google password will NOT work — App Passwords need 2FA enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Set to change the visible From address.
SMTP_FROM=
